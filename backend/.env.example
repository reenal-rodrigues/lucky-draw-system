# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL Connection String
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Leave empty or set to "local" during initial local testing to use the embedded persistent PostgreSQL engine.
DATABASE_URL=local
DATABASE_SSL=false

# Authentication Secrets
JWT_SECRET=lucky_draw_secure_jwt_secret_key_2026_production_ready
JWT_EXPIRES_IN=24h

# Ticket & Reservation Configuration
RESERVATION_EXPIRY_MINUTES=5
DEFAULT_TICKET_PRICE=50
DEFAULT_TOTAL_TICKETS=200

